# LLM provider: deepseek | anthropic
LLM_PROVIDER=deepseek

# DeepSeek（国内直连）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Anthropic（LLM_PROVIDER=anthropic 时填，需代理）
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# Embedding provider: bge | dashscope | openai
EMBEDDING_PROVIDER=bge

# HuggingFace 镜像（国内下载 BGE 模型用）
HF_ENDPOINT=https://hf-mirror.com

# 通义（EMBEDDING_PROVIDER=dashscope 时填）
DASHSCOPE_API_KEY=

# OpenAI（EMBEDDING_PROVIDER=openai 时填）
OPENAI_API_KEY=

# Milvus Lite gRPC 服务地址（Windows 用 server 模式；嵌入式 .db 不支持）
MILVUS_URI=http://127.0.0.1:19530

# PostgreSQL 业务数据库（个人家电名单 + 维修历史）
# 格式：postgresql+psycopg2://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/appliance_doctor

# 数据目录（默认 backend 上一级的 data/）
DATA_DIR=../data
