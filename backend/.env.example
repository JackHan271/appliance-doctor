# LLM provider: deepseek | anthropic
LLM_PROVIDER=deepseek

# DeepSeek（国内直连）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Anthropic（LLM_PROVIDER=anthropic 时填，需代理）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Embedding provider: bge | dashscope | openai
EMBEDDING_PROVIDER=bge

# HuggingFace 镜像（国内下载 BGE 模型用）
HF_ENDPOINT=https://hf-mirror.com

# 通义（EMBEDDING_PROVIDER=dashscope 时填）
DASHSCOPE_API_KEY=

# OpenAI（EMBEDDING_PROVIDER=openai 时填）
OPENAI_API_KEY=

# Milvus Lite gRPC 服务地址（Windows 用 server 模式；嵌入式 .db 不支持）
MILVUS_URI=http://127.0.0.1:19530

# PostgreSQL 业务数据库（个人家电名单 + 维修历史）
# 格式：postgresql+psycopg2://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/appliance_doctor

# 数据目录（默认 backend 上一级的 data/）
DATA_DIR=../data

# ============================================================
# 2026-10-16 新增：可观测 / 成本控制 / RAG 进阶 / 证据核验
# 全部有默认值，不配也能跑；这里写出来是为了显式可控
# ============================================================

# --- 模型路由（成本控制）---
# 强模型用于 诊断 / 安全审查 / 证据核验；轻模型用于 摘要 / 分类等高频轻任务
# 两者留空则都回退到 DEEPSEEK_MODEL（行为不变）
# 想提升诊断质量可把 STRONG 换成 deepseek-reasoner（更贵更慢）
DEEPSEEK_MODEL_STRONG=deepseek-chat
DEEPSEEK_MODEL_LIGHT=deepseek-chat

# --- LLM 响应缓存（仅 temperature≈0 时生效）---
CACHE_ENABLED=1
CACHE_TTL=3600
CACHE_MAXSIZE=512
# 留空 = 进程内内存缓存；填 redis://127.0.0.1:6379/0 = 用 Redis（需先 pip install redis）
REDIS_URL=

# --- RAG 检索链路 ---
# hybrid = 稠密向量 + BM25 关键词 → RRF 融合 → Cross-Encoder 重排
# dense  = 退回原来的纯向量检索
RAG_MODE=hybrid
RAG_RECALL_N=20
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=20

# --- 分库检索：配额 + 加权 ---
# 配额 = 每个知识库保底进入重排器的候选数（保证两类知识都能被重排器看到）
RAG_QUOTA={"fault_code": 12, "manual": 8}
# 权重 = 加权 RRF 里各库的权威度（故障码是结构化高置信知识，权重更高）
RAG_WEIGHTS={"fault_code": 1.5, "manual": 1.0}

# --- 上下文工程 / 记忆 ---
CONTEXT_BUDGET_TOKENS=3000
HISTORY_KEEP_TURNS=3
SUMMARY_MAX_CHARS=600

# --- Milvus gRPC keepalive（调长以避免被 too_many_pings 限流断连）---
MILVUS_KEEPALIVE_MS=60000

# --- 启动时预热本地模型（embedding + 重排），避免首个请求特别慢 ---
WARMUP_MODELS=1
